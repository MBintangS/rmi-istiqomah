# Frontend environment
# Cutover lokal / produksi satu domain:
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rollback ke Express (lokal atau Render) — jangan dipakai bersamaan dengan cutover:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_API_URL=https://rmi-istiqomah-api.onrender.com/api

# Production Vercel:
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Analytics 4 (opsional). Kosongkan untuk menonaktifkan.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only untuk Next.js Route Handlers (jangan prefix NEXT_PUBLIC_)
# Salin dari backend/.env ke frontend/.env.local — jangan di-commit.
MONGODB_URI=mongodb://127.0.0.1:27017/rmi-dev
JWT_SECRET=ganti-dengan-secret-yang-sama-dengan-backend
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rmi
